# Salin konfigurasi ini ke .env.local tanpa menghapus variabel lain yang sudah ada.
# Isi nilai secara lokal. File .env.local tidak masuk Git.

# Supabase: Project Settings > API / API Keys.
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=
# Secret key (sb_secret_...) hanya untuk server dan penyiapan akun.
# Jika proyek masih memakai key lama, service_role dapat diisi di variabel ini.
SUPABASE_SECRET_KEY=

# Rahasia server untuk autentikasi PIN. Gunakan 64 karakter hexadecimal acak.
# Buat secara lokal: node -e "process.stdout.write(require('node:crypto').randomBytes(32).toString('hex'))"
# Jangan ubah setelah akun PIN dibuat tanpa melakukan reset akun PIN.
PIN_AUTH_SECRET=

# Empat PIN awal untuk pilot Grup 2. Gunakan tepat 8 digit dan semua harus berbeda.
# Angka nol di awal diperbolehkan. PIN tidak boleh memakai prefix NEXT_PUBLIC_.
# DanGrup memantau ketiga elemen dan membuat laporan; tidak mencatat presensi.
PIN_GROUP_2=
# Setiap DanElemen hanya mencatat dan melihat anggota elemennya.
PIN_GROUP_2_ELEMENT_1=
PIN_GROUP_2_ELEMENT_2=
PIN_GROUP_2_ELEMENT_3=
